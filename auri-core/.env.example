# auri-core settings (copy to .env; every key is optional)
# AURI_CORE_DATA_DIR=data
# AURI_CORE_OLLAMA_URL=http://127.0.0.1:11434
# AURI_CORE_MODEL_CODE=gemma4:e2b
# AURI_CORE_MODEL_ROLES=qwen3.5:4b
# AURI_CORE_MODEL_EMBED=embeddinggemma
# AURI_CORE_KEEP_ALIVE=10m
# AURI_CORE_PORT=8791
# AURI_CORE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AURI_CORE_SUPABASE_URL=https://<project>.supabase.co   (unset → every caller is a guest, reads T0 only)
# AURI_CORE_SUPABASE_ANON_KEY=
# AURI_CORE_MODEL_L3=            (P6: stronger local model for escalation; empty = none)
# AURI_CORE_CLOUD_MODE=off       (off | ask | auto_general — cloud only if you turn it on)
# AURI_CORE_CLOUD_MODEL=
# AURI_CORE_RAM_BUDGET_GB=5
# AURI_CORE_BACKGROUND=light      (off | light: maintenance without a model | full: + model jobs at night)
# AURI_CORE_GROQ_API_KEY=
# AURI_CORE_GEMINI_API_KEY=
# AURI_CORE_GEMINI_PAID=0       (1 = paid project; the free tier is never used)
# AURI_CORE_CLOUD_DAILY_CAP=20
