# auri-jarvis/.env.example — copy to .env and fill in. Placeholders only; .env is gitignored.
# Secrets live ONLY here, never in the YAML files (spec 6.2).

ELEVENLABS_API_KEY=            # optional; empty → tts falls back to local Piper
ELEVENLABS_VOICE_ID=           # overrides the yaml voice (default: Daniel)
ELEVENLABS_MODEL_ID=           # optional model override (e.g. eleven_flash_v2_5)
SUPABASE_URL=                  # login check (= web VITE_SUPABASE_URL)
SUPABASE_ANON_KEY=             # PUBLIC anon key (= web VITE_SUPABASE_ANON_KEY) — never the service key
JARVIS_HUD_TOKEN=              # empty → a random token is generated at every start
JARVIS_INPUT_DEVICE=           # microphone index or name fragment (overrides audio.yaml)
