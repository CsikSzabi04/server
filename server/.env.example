# ─────────────────────────────────────────────────────────────────────────────
# Auri AI server configuration
# Copy this file to `.env` (the generate-key script also creates it for you):
#   cp .env.example .env        (Linux/Mac)
#   Copy-Item .env.example .env (Windows PowerShell)
# ─────────────────────────────────────────────────────────────────────────────

# The PUBLIC-facing port of THIS server.
# Your Cloudflare Tunnel / ngrok must point here — NEVER at Ollama's 11434.
PORT=8787

# Secret API key(s). Generate a strong one with:  npm run generate-key
# Multiple keys can be comma-separated to allow zero-downtime rotation:
#   AURI_API_KEY=auri_sk_new,auri_sk_old
# This is the value you copy into CliMark's AURI_SERVER_API_KEY env var.
AURI_API_KEY=auri_sk_CHANGE_ME

# Ollama runtime URL — keep it LOCAL ONLY. This port must never be public.
OLLAMA_URL=http://localhost:11434

# Default model used when a request does not specify "model".
# Swap by: ollama pull <model>  +  changing this line  (no code change needed).
OLLAMA_MODEL=llama3.2:3b
# Requests with images (pasted screenshot / photo) use this local vision model
OLLAMA_VISION_MODEL=gemma4:e2b

# CORS allow-list (comma separated). Only needed if a BROWSER calls this server.
# For server-to-server calls (the normal case) you can leave this empty.
ALLOWED_ORIGINS=https://climarkai.com

# Requests per minute, per API key (falls back to per IP). 0 = unlimited.
RATE_LIMIT_PER_MIN=60

# How long to wait for Ollama before returning 503 (ms). Raise on slow CPUs.
OLLAMA_TIMEOUT_MS=60000

# Privacy: log full prompt contents? Off by default.
LOG_PROMPTS=false

# Input guard rails.
MAX_MESSAGES=100
MAX_PROMPT_CHARS=24000

# ─── Inference quality + speed (Ollama) ───────────────────────────────────────
# Keep the model loaded in RAM so there is no cold start. "30m", "1h" or -1 (forever).
OLLAMA_KEEP_ALIVE=30m
# Context window: bigger = remembers more (smarter), but slower / more RAM.
OLLAMA_NUM_CTX=4096
# Default max generated tokens when a request omits max_tokens.
OLLAMA_NUM_PREDICT=768
# CPU threads / batch (0 = let Ollama decide).
OLLAMA_NUM_THREAD=0
OLLAMA_NUM_BATCH=0
# Sampling defaults (overridable per request).
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
# Default persona injected when the request has no system message. Set empty to disable.
# AURI_SYSTEM_PROMPT=
# Concurrency gate for CPU-bound inference; overload -> 503 server_busy.
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_QUEUE_LIMIT=24
# Preload the model on boot so the first request is fast.
WARMUP_ON_BOOT=true

# ─── Piper text-to-speech (local, free) — powers POST /v1/tts ─────────────────
# Enabled by default; the endpoint only works if the binary + voice exist below.
PIPER_ENABLED=true
# Paths are relative to the server/ working directory (or use absolute paths).
PIPER_BIN=../PublicFreeAI/Piper/piper/piper.exe
PIPER_VOICE=../PublicFreeAI/Piper/voices/hu_HU-anna-medium.onnx
# Per-request limits / timeout.
PIPER_TIMEOUT_MS=30000
PIPER_MAX_CHARS=1200
