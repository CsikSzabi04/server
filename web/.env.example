# ─────────────────────────────────────────────────────────────────────────────
# AuriGPT frontend configuration.  Copy to `.env` for local dev if needed.
#
#   ⚠️  SECURITY: every VITE_* variable is BUNDLED INTO THE PUBLIC CLIENT JS.
#       NEVER put the real secret API key in VITE_API_KEY for a public deploy.
#       In production the key lives ONLY in the Vercel serverless proxy
#       (AURI_SERVER_API_KEY, set in the Vercel dashboard — NOT here, NOT VITE_).
# ─────────────────────────────────────────────────────────────────────────────

# Where the frontend sends chat requests.
#   - LEAVE EMPTY            -> MOCK mode (works with no backend; great for demos / GitHub Pages)
#   - "/api/chat"            -> use the Vercel serverless proxy (RECOMMENDED for production)
#   - "https://.../v1/chat"  -> call the backend DIRECTLY (only for private/local testing!)
VITE_API_URL=

# Optional bearer key — ONLY for the direct-call testing case above.
# Do NOT set this for a public deploy (it would be exposed in the bundle).
VITE_API_KEY=

# ─── Server-side ONLY (used by web/api/chat.ts on Vercel; set in Vercel dashboard) ──
# These are NOT VITE_ prefixed, so they are never sent to the browser.
#
# Provider fallback chain (each used only if the previous is unavailable):
#   1) LOCAL Ollama (your PC, via tunnel) — used only when reachable + healthy
#   2) Groq  (free, fast, smart) — used when your PC is off
#   3) Gemini (free) — last resort
#
#   AURI_SERVER_URL=https://<your-cloudflare-tunnel>
#   AURI_SERVER_API_KEY=auri_sk_...
#   GROQ_API_KEY=gsk_...            # from https://console.groq.com  (FREE — not xAI "Grok"!)
#   GROQ_MODEL=llama-3.3-70b-versatile
#   GEMINI_API_KEY=...             # from https://aistudio.google.com/app/apikey
#   GEMINI_MODEL=gemini-2.0-flash
