# ─────────────────────────────────────────────────────────────────────────────
# AuriGPT frontend configuration.  Copy to `.env` for local dev if needed.
#
#   ⚠️  SECURITY: every VITE_* variable is BUNDLED INTO THE PUBLIC CLIENT JS.
#       NEVER put the real secret API key in VITE_API_KEY for a public deploy.
#       In production the key lives ONLY in the Vercel serverless proxy
#       (AURI_SERVER_API_KEY, set in the Vercel dashboard — NOT here, NOT VITE_).
# ─────────────────────────────────────────────────────────────────────────────

# Where the frontend sends chat requests.
#   - LEAVE EMPTY            -> MOCK mode (works with no backend; great for demos / GitHub Pages)
#   - "/api/chat"            -> use the Vercel serverless proxy (RECOMMENDED for production)
#   - "https://.../v1/chat"  -> call the backend DIRECTLY (only for private/local testing!)
VITE_API_URL=

# Optional bearer key — ONLY for the direct-call testing case above.
# Do NOT set this for a public deploy (it would be exposed in the bundle).
VITE_API_KEY=

# Supabase (login + chat saving). The publishable/anon key is safe in the client
# (Row Level Security protects the data). Get these from the Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Server-side ONLY (used by web/api/chat.ts on Vercel; set in Vercel dashboard) ──
# These are NOT VITE_ prefixed, so they are never sent to the browser.
#
# Provider fallback chain (each used only if the previous is unavailable):
#   1) LOCAL Ollama (your PC, via tunnel) — used only when reachable + healthy
#   2) Groq  (free, fast, smart) — used when your PC is off
#   3) Gemini (free) — last resort
#
#   AURI_SERVER_URL=https://<your-cloudflare-tunnel>
#   AURI_SERVER_API_KEY=auri_sk_...
#   GROQ_API_KEY=gsk_...            # from https://console.groq.com  (FREE — not xAI "Grok"!)
#   GROQ_MODEL=openai/gpt-oss-120b
#   GEMINI_API_KEY=...             # from https://aistudio.google.com/app/apikey
#   GEMINI_MODEL=gemini-flash-lite-latest   # "-latest" alias survives model retirements
#   GEMINI_PAID=1                  # REQUIRED to use Gemini at all: only with a billing-enabled
#                                  # Google Cloud project. Google's terms forbid the FREE quota
#                                  # for apps used by EEA/Swiss/UK users (SECURITY.md §14.3).
#
# Images (Ctrl+V screenshot, 📎 picture, 📷 photo) need a vision model. Order: the local
# server (its OLLAMA_VISION_MODEL, default gemma4:e2b — the picture stays on your PC; in dev
# the proxy also talks to Ollama directly), then paid Gemini, then an explicit Groq one:
#   OLLAMA_VISION_MODEL=gemma4:e2b   # dev only (the server has its own in server/.env)
#   GROQ_VISION_MODEL=               # only if Groq offers a vision model again
#
# Spoken voice (api/tts.ts): ElevenLabs first, then Piper on AURI_SERVER_URL, then the
# browser's own voice. Use a SEPARATE ElevenLabs key for Vercel (Text-to-Speech permission
# only) and set a monthly CREDIT LIMIT on it in the ElevenLabs dashboard — a public endpoint
# must never be able to drain the Jarvis key. (Local dev reads ../auri-jarvis/.env and books
# into the shared Jarvis credit ledger instead.)
#   ELEVENLABS_API_KEY=...
#   ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9   # Daniel (default) · JBFqnCBsd6RMkjVDRZzb = George
#   ELEVENLABS_MODEL_ID=eleven_flash_v2_5
#
# Security / abuse controls for the /api/* proxy (SECURITY.md §8, api/_guard.ts):
#   SUPABASE_URL=, SUPABASE_ANON_KEY=   # optional; falls back to the VITE_ pair above
#   AURI_REQUIRE_LOGIN=1                # optional; reject guests (signed-in users only)
#   ALLOWED_ORIGINS=https://other.site  # optional; extra browser origins allowed to call /api
#   LIMIT_CHAT_GUEST_MIN=8              # optional rate limits: LIMIT_<CHAT|SEARCH|TTS>_<USER|GUEST>_<MIN|DAY>
